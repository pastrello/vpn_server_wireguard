SECRET_KEY=troque-esta-chave
PSK_ENCRYPTION_KEY=troque-esta-chave-fernet

DATABASE_URL=postgresql+psycopg://vpnhub:troque_a_senha@127.0.0.1:5432/vpnhub

VPN_ENDPOINT=vpn.exemplo.com.br:51820
VPN_SERVER_PUBLIC_KEY=COLOQUE_A_PUBLIC_KEY_DO_SERVIDOR
VPN_ADDRESS_POOL=10.250.0.0/16

WG_INTERFACE=wg0
WG_LISTEN_PORT=51820
WG_SERVER_ADDRESS=10.250.0.1/16
WG_SERVER_PRIVATE_KEY_PATH=/etc/wireguard/vpnhub-server.key
WG_ROUTE_PROTOCOL=186
WG_ONLINE_SECONDS=180
WG_IDLE_SECONDS=600
WG_DRY_RUN=true

CONTROLLER_SOCKET=/run/vpnhub/controller.sock
CONTROLLER_ALLOWED_USER=vpnhub

PORTAL_BIND=0.0.0.0:8080
SESSION_COOKIE_SECURE=false
