[Unit]
Description=VPNHub Reconcile WireGuard State
After=network-online.target postgresql.service vpnhub-controller.service
Requires=vpnhub-controller.service
Wants=network-online.target

[Service]
Type=oneshot
User=vpnhub
Group=vpnhub
WorkingDirectory=/opt/vpnhub
EnvironmentFile=/etc/vpnhub/vpnhub.env
ExecStart=/opt/vpnhub/venv/bin/python /opt/vpnhub/scripts/reconcile.py
TimeoutStartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/vpnhub

[Install]
WantedBy=multi-user.target
